<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <node name="/org/stumblefish/Companions">
    <interface name="org.stumblefish.Companions">
      <method name="registerCompanion">
           <arg type="s" name="companion_name" direction="in"/>
      </method>
      <method name="availableCompanions">
           <arg type="as" direction="out"/>
      </method>
    </interface>
  </node>
  <node name="/org/stumblefish/Tracker">
    <interface name="org.stumblefish.Tracker" />
  </node>
  <node name="/org/stumblefish/JollaPass">
    <interface name="org.stumblefish.JollaPass" />
  </node>
  <node name="/org/stumblefish/Lookout">
    <interface name="org.stumblefish.Lookout" />
  </node>
</node>
