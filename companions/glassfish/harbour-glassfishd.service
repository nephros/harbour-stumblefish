# SPDX-License-Identifier: MIT
[Unit]
Description=Stumblefish Glassfish Companion
BindsTo=harbour-stumblefishd.service
PartOf=harbour-stumblefishd.service
After=harbour-stumblefishd.service

PartOf=harbour-stumblecompanions.target

[Service]
Type=dbus
BusName=org.stumblefish.Companion.Lookout
ExecStart=/usr/libexec/harbour-glassfishd
Restart=on-failure

Nice=15

ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=harbour-stumblefishd.service
WantedBy=harbour-stumblecompanions.target
