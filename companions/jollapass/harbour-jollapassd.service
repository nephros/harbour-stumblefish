# SPDX-License-Identifier: MIT
[Unit]
Description=Stumblefish JollaPass Companion
BindsTo=harbour-stumblefishd.service
PartOf=harbour-stumblefishd.service
After=harbour-stumblefishd.service

[Service]
ExecStart=/usr/bin/harbour-jollapassd
Restart=on-failure

Nice=15

ProtectSystem=strict
ProtectHome=yes

[Install]
WantedBy=harbour-stumblefishd.service
